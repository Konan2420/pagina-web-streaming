# Copia este archivo como .env.local y completa los valores de TU proyecto Supabase.
# Solo las variables VITE_* se exponen al navegador.
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=TU_SUPABASE_PUBLISHABLE_KEY

# Variables exclusivas del servidor (Server Functions / Nitro).
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=TU_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=TU_SUPABASE_SERVICE_ROLE_KEY

# URL publica definitiva del sitio. Usala tambien en los redirects de Supabase Auth.
VITE_APP_URL=https://cmdstreaming.pe
